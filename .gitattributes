# Force LF line endings for all files that end up in the container
# Windows CRLF breaks shell shebangs and s6-overlay
*.sh text eol=lf
Dockerfile text eol=lf
casa/rootfs/**/* text eol=lf
casa/apparmor.txt text eol=lf
casa/config.yaml text eol=lf
casa/build.yaml text eol=lf
casa/requirements.txt text eol=lf
casa_browser/rootfs/**/* text eol=lf
casa_browser/apparmor.txt text eol=lf
casa_browser/config.yaml text eol=lf
casa_browser/requirements.txt text eol=lf
casa_browser/requirements-test.txt text eol=lf

# Preserve CRLF for legacy-crlf fixture (migration test fixture)
test-local/fixtures/legacy-crlf/** -text
