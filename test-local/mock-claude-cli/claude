#!/usr/bin/env python3
"""Mock `claude` CLI for CI. See §9.1 of the plan-4a design spec.

Usage (exactly mimics real claude):
    claude [--resume=<sid>] --permission-mode <mode> --add-dir <dir>...

(argparse also accepts the two-token `--resume <sid>` form, but Casa's run
script only ever emits the =-joined single token — v0.131.0 hardening.)

Reads user turns line-by-line from stdin. For each turn, appends JSONL
entries for `user` and `assistant` messages to
$HOME/.claude/projects/<slug>/sessions/<sid>.jsonl. On
`/mock emit_completion`, prints a synthetic MCP tool-call JSON line and
exits 0. On `/mock cancel`, exits 0. On `--resume=<sid>`, reads the prior
transcript and prints "Resumed session <sid> with N prior turns" before
entering the main loop.

v0.64.0: no `Remote Control URL:` boot banner — the real headless CLI
never prints one (non-TTY stdout degrades it to --print mode; the
`--remote-control` flag was dropped from the run template). The parser
still tolerates the flag for old harnesses.

#586: two additions, both load-bearing for the restart-survival probe.

`/mock casa_call <tool>` makes a REAL authenticated MCP call the way a real
engagement does — reading the credential pair out of the workspace's own
`.mcp.json` and POSTing to the bridge — and records the raw response in the
workspace so the probe can assert on it. That is the one thing the probe
could not do before: every call it made was unbound.

Each turn now also opens with a `{"type": "system", "subtype": "init"}`
stream-json frame, which is what the real CLI emits and what Casa's topic
relay turns into `turn_start`. Without it a delivered inbound envelope never
becomes `consumed`, so every s6 respawn reverts it to `queued` and redelivers
it — an endless turn loop rather than a probe.
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import sys
import time
import urllib.error
import urllib.request
import uuid


def _parse_args(argv: list[str]) -> dict:
    """Tolerant parse — ignore unknown flags (real CLI adds flags over time)."""
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--remote-control")
    parser.add_argument("--resume")
    parser.add_argument("--permission-mode")
    parser.add_argument("--add-dir", action="append", default=[])
    args, _ = parser.parse_known_args(argv)
    return vars(args)


def _slug(cwd: str) -> str:
    return cwd.replace("/", "-").lstrip("-") or "root"


def _session_path(home: str, cwd: str, sid: str) -> pathlib.Path:
    return pathlib.Path(home) / ".claude" / "projects" / _slug(cwd) / "sessions" / f"{sid}.jsonl"


def _handle_plugin_subcommand(argv: list[str]) -> "int | None":
    """Handle `claude plugin ...` subcommands. Returns exit code or None if not a plugin call."""
    if not argv or argv[0] != "plugin":
        return None
    sub = argv[1] if len(argv) > 1 else ""
    arg2 = argv[2] if len(argv) > 2 else ""
    if sub == "install":
        print(f"Installed: {arg2}", flush=True)
        return 0
    if sub == "uninstall":
        print(f"Uninstalled: {arg2}", flush=True)
        return 0
    if sub == "list":
        if arg2 == "--json":
            plugin_list_json = os.environ.get("MOCK_CLAUDE_PLUGIN_LIST_JSON", "")
            if plugin_list_json and os.path.isfile(plugin_list_json):
                with open(plugin_list_json, encoding="utf-8") as fh:
                    print(fh.read(), flush=True)
            else:
                print("[]", flush=True)
        return 0
    if sub == "marketplace":
        mkt_sub = argv[2] if len(argv) > 2 else ""
        mkt_arg = argv[3] if len(argv) > 3 else ""
        if mkt_sub == "update":
            print(f"Updated: {mkt_arg}", flush=True)
            return 0
        if mkt_sub == "add":
            print(f"Added: {mkt_arg}", flush=True)
            return 0
        if mkt_sub == "remove":
            print("casa-plugins-defaults is seed-managed", file=sys.stderr, flush=True)
            return 1
        print(f"Unknown marketplace subcommand: {mkt_sub}", file=sys.stderr, flush=True)
        return 1
    print(f"Unknown plugin subcommand: {sub}", file=sys.stderr, flush=True)
    return 1


_CASA_CALL_PREFIX = ".mock_casa_call."


def _pinned_cli_version() -> str:
    """The version `claude_runtime.verify_effective_cli` insists on.

    casa-main fails CLOSED at boot when `claude --version` does not match its
    pin — a production guard against an unexpected CLI. In the mock image the
    substitution IS intended, so the mock answers the pin. Read out of the
    source rather than hardcoded: a literal here would drift on the next CLI
    bump and break every mock-gated e2e with an unrelated-looking boot crash.
    """
    try:
        with open("/opt/casa/claude_runtime.py", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("CLAUDE_CLI_VERSION"):
                    return line.split("=", 1)[1].strip().strip("\"'")
    except OSError:
        pass
    return "0.0.0"


def _casa_call(tool: str) -> dict:
    """#586: call `tool` over the casa-framework bridge as THIS engagement.

    The credential pair lives in the workspace's `.mcp.json`, exactly where a
    real CLI's MCP client reads it from — so this exercises header forwarding
    and per-engagement token verification, not a test double.
    """
    try:
        with open("./.mcp.json", encoding="utf-8") as fh:
            server = json.load(fh)["mcpServers"]["casa-framework"]
        url = server["url"]
        headers = dict(server.get("headers") or {})
    except Exception as exc:  # noqa: BLE001 — recorded, not raised
        return {"mock_error": f"unusable .mcp.json: {exc}"}

    body = json.dumps({
        "jsonrpc": "2.0", "id": 1, "method": "tools/call",
        "params": {"name": tool, "arguments": {}},
    }).encode("utf-8")
    headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=body, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        # A JSON-RPC error still arrives with a 200 from the bridge; anything
        # else is a transport failure and is recorded as such.
        try:
            return json.loads(exc.read().decode("utf-8"))
        except Exception:  # noqa: BLE001
            return {"mock_error": f"http {exc.code}"}
    except Exception as exc:  # noqa: BLE001
        return {"mock_error": f"{type(exc).__name__}: {exc}"}


def _record_casa_call(payload: dict) -> str:
    """Write the response to the next free numbered file in the workspace.

    Numbered rather than overwritten: a turn is one CLI process, so the probe
    reads the file its step produced instead of racing a later one.
    """
    n = len([p for p in os.listdir(".") if p.startswith(_CASA_CALL_PREFIX)])
    path = f"{_CASA_CALL_PREFIX}{n:03d}.json"
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(payload, fh)
    return path


def main() -> int:
    if "--version" in sys.argv[1:]:
        print(f"{_pinned_cli_version()} (Claude Code)", flush=True)
        return 0

    # Handle plugin subcommands before the remote-control parser.
    rc = _handle_plugin_subcommand(sys.argv[1:])
    if rc is not None:
        return rc

    args = _parse_args(sys.argv[1:])
    home = os.environ.get("HOME", "/tmp/mock-home")
    cwd = os.getcwd()

    if args["resume"]:
        sid = args["resume"]
        path = _session_path(home, cwd, sid)
        prior = 0
        if path.exists():
            with path.open("r", encoding="utf-8") as fh:
                for line in fh:
                    if line.strip():
                        prior += 1
        print(f"Resumed session {sid} with {prior} prior turns", flush=True)
    else:
        # Dashed form — matches the real CLI's session ids AND the run
        # script's v0.131.0 UUID validation (an undashed .hex value would be
        # rejected there, silently breaking every mock resume).
        sid = str(uuid.uuid4())
        # Persist session_id to .session_id so a subsequent respawn can resume.
        pathlib.Path("./.session_id").write_text(sid, encoding="utf-8")
        path = _session_path(home, cwd, sid)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.touch()

    # Main loop: read stdin line by line.
    for line in sys.stdin:
        text = line.rstrip("\n")
        if not text:
            continue
        # A turn begins. The real CLI opens every turn with this stream-json
        # frame and Casa's topic relay converts it into `turn_start`, which is
        # the ONLY evidence that marks the delivered inbound envelope
        # `consumed`. Emit it before handling the turn (see module docstring).
        print(json.dumps({
            "type": "system", "subtype": "init", "session_id": sid,
        }), flush=True)
        # #586: authenticated MCP call from inside the engagement.
        if text.startswith("/mock casa_call"):
            tool = (text[len("/mock casa_call"):].strip()
                    or "list_engagement_workspaces")
            path = _record_casa_call(_casa_call(tool))
            print(f"(mock) casa_call {tool} -> {path}", flush=True)
            continue
        # Trigger: emit_completion
        if text.startswith("/mock emit_completion"):
            payload = text[len("/mock emit_completion"):].strip() or "{}"
            try:
                payload_obj = json.loads(payload)
            except json.JSONDecodeError:
                payload_obj = {"text": payload}
            print(json.dumps({
                "type": "tool_use",
                "name": "mcp__casa-framework__emit_completion",
                "input": payload_obj,
            }), flush=True)
            return 0
        if text.startswith("/mock cancel"):
            return 0

        # Normal turn: append user + assistant JSONL, echo to stdout.
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps({"role": "user", "text": text,
                                 "ts": time.time()}) + "\n")
            reply = f"(mock) You said: {text}"
            fh.write(json.dumps({"role": "assistant", "text": reply,
                                 "ts": time.time()}) + "\n")
        print(reply, flush=True)

    return 0


if __name__ == "__main__":
    sys.exit(main())
